# Tenant Dashboard service — three different Postgres connections, on purpose:

# 1. This service's OWN control database (tenant_dashboard_control) — one
#    physical database for the whole service, holds TenantAccount only.
CONTROL_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/tenant_dashboard_control?schema=public"

# 2. A superuser/owner connection used ONLY to CREATE DATABASE for a new
#    tenant during provisioning — connects to Postgres's `postgres`
#    maintenance database, not any app database. Keep this narrowly scoped
#    in a real deployment (a role that can create databases and nothing
#    else); local dev can reuse the same postgres superuser as above.
PROVISION_DB_ADMIN_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# 3. The template used to build a connection string to any ONE tenant's own
#    database, once it exists — {dbName} is replaced with that tenant's
#    database name (see src/tenant-db/tenant-db.util.ts). Same Postgres
#    server as the two above for local dev; doesn't have to be in
#    production (each tenant database could even live on a different host).
TENANT_DB_URL_TEMPLATE="postgresql://postgres:postgres@127.0.0.1:5432/{dbName}?schema=public"

PORT=3002
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5174"

# Shared with Super Admin's backend (SAME value on both sides) — guards the
# internal /api/internal/provision-tenant endpoint. Never exposed to a
# browser; this is service-to-service only.
TENANT_DASHBOARD_INTERNAL_SECRET="replace-with-a-long-random-string"
