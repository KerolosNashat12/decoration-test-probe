// Tenant Dashboard service — PER-TENANT schema. This is a *template*: the
// same migration files under prisma/tenant/migrations get applied to a
// brand new, empty Postgres database for every tenant, by
// ProvisioningService, one physical database per tenant (see
// ARCHITECTURE.md "Multi-tenant isolation — decided"). It is never applied
// twice against the control database, and no tenant ever shares this
// database with another tenant.
//
// `DATABASE_URL` here is intentionally the *generic* env var name (not
// CONTROL_DATABASE_URL): at provisioning time the caller sets it to that
// one new tenant's database before invoking `prisma migrate deploy`, and
// at request time TenantPrismaFactory does the same per-connection.

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/tenant"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantCategory {
  TILES_CERAMICS
  PAINT_COATINGS
  SANITARY_WARE
  ELECTRICAL_FIXTURES
  HARDWARE
  CARPENTRY_WOOD
}

// The tenant's own view of their shop info — seeded from Super Admin's
// Tenant record at provisioning time, editable by the tenant afterwards.
// Deliberately a single row: `tenantId` is unique and there is exactly one
// tenant per database, so nothing here is ever scoped by a tenantId column
// the way a shared-database design would need.
model Profile {
  id          String           @id @default(uuid())
  tenantId    String           @unique // == super-admin Tenant.id / control-db TenantAccount.id
  name        String
  contactName String
  phone       String
  whatsapp    String?
  email       String?
  district    String?
  categories  TenantCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile")
}

// The tenant's product catalog. See the Tenant Dashboard SRS, §9-§11, for
// the full field list, validation rules, and the deactivate-vs-delete flow.
model Product {
  id          String         @id @default(uuid())
  name        String
  description String?
  category    TenantCategory
  price       Decimal        @db.Decimal(10, 2)
  unit        String
  photoUrl    String?
  isActive    Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfqResponses RfqResponse[]

  @@map("product")
}

enum RfqStatus {
  NEW
  RESPONDED
  DECLINED
  EXPIRED
}

// A buyer's request for quotation. Until the Public Website (Phase 3)
// exists, `isTest` rows are created via the internal seed endpoint (SRS
// §14) so this flow can be exercised end to end against real data.
model Rfq {
  id            String         @id @default(uuid())
  buyerName     String
  buyerPhone    String
  category      TenantCategory
  description   String
  quantity      String?
  deadlineAt    DateTime?
  status        RfqStatus      @default(NEW)
  isTest        Boolean        @default(false)
  declineReason String?
  declinedAt    DateTime?

  createdAt DateTime @default(now())

  response RfqResponse?

  @@map("rfq")
}

// A tenant's quote in reply to one RFQ. 1:1 with Rfq (rfqId is unique) —
// only ever created by the "respond" action (SRS §13); a "decline" sets
// Rfq.status directly and never creates one of these rows.
model RfqResponse {
  id  String @id @default(uuid())
  rfq   Rfq    @relation(fields: [rfqId], references: [id])
  rfqId String @unique

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  price            Decimal @db.Decimal(10, 2)
  priceUnit        String
  availabilityNote String?
  message          String?

  respondedAt DateTime @default(now())

  @@map("rfq_response")
}
