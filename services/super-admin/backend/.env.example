# Super Admin service — isolated database, not shared with any other service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/super_admin_db?schema=public"

PORT=3001
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"

# Tenant Dashboard service's internal API — called once, right after a
# tenant application is approved, to provision that tenant's own database
# and dashboard login. Optional: if unset, approval still works, it just
# leaves the tenant without dashboard access until provisioned later (the
# "Provision dashboard access" retry on the Tenants page). Must be the
# SAME secret value as TENANT_DASHBOARD_INTERNAL_SECRET on that service.
TENANT_DASHBOARD_API_URL="http://localhost:3002/api"
TENANT_DASHBOARD_INTERNAL_SECRET="replace-with-a-long-random-string"
